APP_NAME="Neighborhood Crime Report"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crime-report-api.vercel.app
FRONTEND_URL=https://crime-report-web.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mongodb
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=crime_report

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_URL=rediss://default:PASSWORD@HOST:6379

SANCTUM_STATEFUL_DOMAINS=localhost:5173,crime-report-web.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://crime-report-web.vercel.app

CRON_SECRET=change-me-long-random

GEOCODER_DRIVER=nominatim
NOMINATIM_USER_AGENT=NeighborhoodCrimeReport/1.0 (contact@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

OVERPASS_URL=https://overpass-api.de/api/interpreter

NEWS_PROVIDERS=gdelt,rss
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWSAPI_KEY=
NEWS_MAX_ARTICLES_PER_REPORT=40

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1200

STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CREDITS_PACK=

FREE_REPORT_CREDITS=3
FREE_RADIUS_KM=1
PAID_RADII_KM=3,5,10
